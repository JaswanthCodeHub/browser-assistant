# Empty keys keep text inference on Ollama; vision requires a Groq key.
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Optional comma-separated vision models available on YOUR account; empty by default.
GROQ_VISION_FALLBACK_MODELS=
OLLAMA_MODEL=llama3
OLLAMA_HOST=http://127.0.0.1:11434
CODE_DEFAULT_LANGUAGE=python
FAST_SCAN_MODE=true
VISION_MAX_TOKENS=1200
GROQ_REVIEW_TOKEN_LIMIT=4096
SERVER_HOST=127.0.0.1
# Optional additional hostnames for a deliberately configured local deployment.
SERVER_ALLOWED_HOSTS=
# Optional URL-safe pairing token (32–128 characters). Leave empty to generate a local token.
ASSISTANT_LOCAL_TOKEN=
# Empty preserves the existing server/scan_history.db location.
HISTORY_DB_PATH=
