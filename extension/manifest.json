{
    "manifest_version": 3,
    "name": "Browser Assistant",
    "version": "2.9.0",
    "description": "Scans webpages for MCQs and coding problems. Powered by Groq (cloud) and Ollama (local fallback).",
    "permissions": [
        "activeTab",
        "scripting",
        "tabs",
        "clipboardWrite",
        "storage",
        "alarms"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html"
    },
    "content_scripts": [
        {
            "matches": [
                "https://learning.ccbp.in/*",
                "https://admissions.aurora.edu.in/*",
                "http://127.0.0.1:8000/*"
            ],
            "js": [
                "automation-policy.js",
                "editor-bridge.js",
                "question-visuals.js",
                "answer-requests.js",
                "coding-automation.js",
                "coding-batch.js",
                "content.js",
                "journal-automation.js"
            ],
            "css": [
                "styles.css"
            ]
        }
    ],
    "host_permissions": [
        "http://localhost:8000/*",
        "http://127.0.0.1:8000/*",
        "https://learning.ccbp.in/*",
        "https://ide.ccbp.in/*",
        "https://admissions.aurora.edu.in/*"
    ],
    "commands": {
        "toggle-automation": {
            "description": "Start, pause or resume Browser Assistant automation"
        }
    }
}
