{
  "name": "browser-assistant",
  "version": "2.9.10",
  "description": "Chrome extension and local Python backend for exploring webpage questions and coding exercises",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JaswanthCodeHub/browser-assistant.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "LICENSE",
    "extension/manifest.json",
    "extension/background.js",
    "extension/detached-panel-background.js",
    "extension/detached-panel.html",
    "extension/detached-panel.js",
    "extension/editor-bridge.js",
    "extension/automation-policy.js",
    "extension/question-visuals.js",
    "extension/answer-requests.js",
    "extension/coding-automation.js",
    "extension/coding-batch.js",
    "extension/content.js",
    "extension/journal-automation.js",
    "extension/popup.html",
    "extension/popup.js",
    "extension/styles.css",
    "server/.env.example",
    "server/code_contract.py",
    "server/journal.py",
    "server/journal_prompt.md",
    "server/journal_syllabus.json",
    "server/local_security.py",
    "server/main.py",
    "server/practice_quiz.html",
    "server/requirements.lock.txt",
    "server/requirements.txt",
    "server/vision_images.py"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "npm run build && node --test extension/*.test.cts",
    "test:browser": "npm run build && node --test scripts/test_separate_panel.cjs"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "linkedom": "^0.18.12",
    "playwright": "1.65.0",
    "typescript": "5.9.3"
  }
}
